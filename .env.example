# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Default SQLite for zero-config local run; Replace with PostgreSQL URL for production)
# SQLite: "file:./dev.db"
# PostgreSQL: "postgresql://username:password@localhost:5432/secure_exam_db?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:3000
